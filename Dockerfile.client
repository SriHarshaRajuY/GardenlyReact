# ============================================
# Gardenly Frontend – Multi-stage Dockerfile
# Stage 1: Build the Vite React app
# Stage 2: Serve with Nginx
# ============================================

# ---------- Stage 1: Build ----------
FROM node:20-alpine AS build

WORKDIR /app

# Copy client package files and install all deps (including devDeps for build)
COPY client/package.json client/package-lock.json ./
RUN npm ci

# Copy client source code
COPY client/ ./

# Build the production bundle (outputs to /app/dist)
RUN npm run build

# ---------- Stage 2: Serve ----------
FROM nginx:alpine

# Remove default Nginx config
RUN rm /etc/nginx/conf.d/default.conf

# Copy our custom Nginx config
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy the built static files from stage 1
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
