MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>
PORT=3000
NODE_ENV=production
GOOGLE_CLIENT_ID=your_google_client_id
JWT_SECRET=your_jwt_secret_here
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
MAIL_FROM=Gardenly Support <your_email@gmail.com>
CLOUD_NAME=your_cloudinary_name
CLOUD_API_KEY=your_cloudinary_api_key
CLOUD_API_SECRET=your_cloudinary_api_secret

# --- CLOUD SERVICES (External Accounts) ---
REDIS_URL=rediss://default:<password>@<host>:<port>
SOLR_URL=https://<host>/solr/<core_name>

# --- LOCAL DOCKER SERVICES ---
# (Uncomment these if running via docker-compose or locally)
# REDIS_URL=redis://localhost:6379
# SOLR_URL=http://localhost:8983/solr/gardenly

CLIENT_ORIGIN=http://localhost
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
