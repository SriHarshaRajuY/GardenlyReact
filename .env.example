MONGO_URI=your_mongodb_uri
PORT=3000
NODE_ENV=development
GOOGLE_CLIENT_ID=your_google_client_id
JWT_SECRET=your_jwt_secret
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password
MAIL_FROM=Gardenly Support <your_email@gmail.com>
CLOUD_NAME=your_cloudinary_name
CLOUD_API_KEY=your_cloudinary_key
CLOUD_API_SECRET=your_cloudinary_secret
REDIS_URL=your_redis_url
SOLR_URL=your_solr_url
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# --- BACKEND DEPLOYMENT ---
# Render backend: https://gardenly-api.onrender.com

# --- CLIENT ORIGIN ---
# Example: CLIENT_ORIGIN=http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173

# --- LOCAL DOCKER SERVICES ---
# (Uncomment these to use local Docker instead of cloud services)
# REDIS_URL=redis://localhost:6379
# SOLR_URL=http://localhost:8983/solr/gardenly